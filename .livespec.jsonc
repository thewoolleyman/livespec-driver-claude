// Project-local livespec configuration for livespec-driver-claude.
//
// This repo is the reference Claude Code Driver for the livespec family.
// It dogfoods livespec: the SPECIFICATION/ tree at the repo root is the
// live spec for the Driver's own seam (binding shape, core-root
// resolution, plugin/marketplace manifest, and the Driver-shipped hook
// bundle), and it evolves through /livespec:seed / propose-change /
// revise / doctor / prune-history / critique — exactly the lifecycle
// every consumer project uses.
//
// Scope discipline: this spec governs ONLY what the Driver owns. The
// operation prose, the reference spec-side CLIs, the JSON schemas, and
// the built-in templates all live in livespec core; this tree defers to
// core by citation and never restates the upstream contract. When any
// rule here appears to conflict with livespec core's SPECIFICATION/, the
// upstream rule wins (see SPECIFICATION/README.md §"Upstream pointers").
//
// Authority: livespec/SPECIFICATION/spec.md
//   §"Contract + reference implementations architecture" (the Driver is
//   the thin, agent-runtime-specific binding layer; core is agnostic to
//   it) and livespec/SPECIFICATION/contracts.md §"Plugin distribution",
//   §"Driver-shipped hooks".
//
// This library's own impl tracking lives in a per-repo beads/Dolt TENANT
// database on the shared dolt-server (tenant name "livespec-driver-claude"),
// via livespec-orchestrator-beads-fabro. The connection block below MIRRORS the repo's
// committed .beads/config.yaml; the tenant password is supplied via the
// BEADS_DOLT_PASSWORD environment variable at bd-call time and is NEVER
// committed here.
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  // Dispatcher/Fabro implementation commits use the operator identity below.
  // Mechanical authors are limited to the GitHub Apps proven by this repo's
  // release and dependency-pin automation/history.
  "git_author": {
    "operator_name": "Chad Woolley",
    "operator_email": "thewoolleyman@gmail.com",
    "mechanical_authors": [
      { "name": "livespec-pr-bot[bot]", "email": "livespec-pr-bot[bot]@users.noreply.github.com" },
      { "name": "livespec-pr-bot[bot]", "email": "283469463+livespec-pr-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "thewoolleyman-factory-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "283469463+thewoolleyman-factory-bot[bot]@users.noreply.github.com" }
    ]
  },
  // Foreman human-valve disposition. Opts this repo's foreman seat into the
  // CONSENSUS tier: a human valve or blocked session may be disposed by a
  // unanimous review panel through foreman-act, instead of being surfaced
  // report-only and left to sit. Enabled 2026-08-21 at the maintainer's
  // explicit fleet-wide direction. The resolver's fail-closed default is
  // "report-only", so an UNSET repo silently surfaces valves and never acts
  // on them -- which is what this key exists to prevent. The contract floors
  // are NOT relaxed: dissent, insufficient information, hard-risk, and
  // human-gated-by-design decisions still escalate regardless of any panel
  // verdict.
  "livespec-overseer": { "foreman_valve_disposition": "consensus" },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  // Allowlist for cross-repo spec-heading references. §"Core-root resolution"
  // cites livespec core's install-verification invariant because that clause is
  // the UPSTREAM OWNER of the projectPath rule this Driver realizes — citing it
  // is what makes the Driver's step 3 a realization rather than a restatement,
  // and restating it here is exactly what the no-cross-spec-reference rule
  // exists to prevent (livespec-dev-tooling-e01t).
  // §"Factory routing" cites livespec-dev-tooling's factory registry heading
  // because that clause owns the registry the committed factory table defers to.
  // That entry is deliberately the BARE heading form: a file-qualified entry is
  // validated against cross_repo_targets.livespec-dev-tooling.local_clone, the
  // host-absolute /data/projects/livespec-dev-tooling, which CI does not expose
  // as a sibling clone, so the pinned core maps it to an empty heading set and
  // drops the entry, failing the citation as "not allowlisted".
  "external_references": {
    "livespec": [
      "SPECIFICATION/contracts.md §\"Plugin distribution\"",
      "§\"Enforcement-suite invocation\""
    ],
    "livespec-dev-tooling": [
      "§\"Fabro factory registry\"",
      "§\"Delegated pre-push gate\""
    ]
  },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by cross-tenant DependsOnEntry refs (`sibling_work_item`,
  // `pull_request`, and `branch`).
  "cross_repo_targets": {
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    },
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    }
  },
  // Conformance Pattern concern #2 (cross-harness plugin-resolution):
  // declares which agent runtimes this project's documented command
  // surface MUST resolve+run from, consumed by the shared
  // check-plugin-resolution Verifier (livespec-zs22.7.7 M6). `claude` is
  // `supported` — this repo IS the Claude Driver, so the /livespec:*
  // surface resolves here; `codex` is `exempt` because the Codex
  // /livespec:* surface ships from the separate livespec-driver-codex
  // Driver, not this repo.
  "harnesses": {
    "claude": { "status": "supported", "canonical_command": "livespec:next" },
    "codex":  { "status": "exempt", "reason": "livespec-driver-claude is the Claude Driver; the Codex /livespec:* surface ships from livespec-driver-codex" }
  },
  // ACTIVE spec_governance overrides. Only the entries this repo
  // intentionally moves off their safe defaults appear here; every
  // unlisted key keeps the shipped default documented in the block below.
  // `propose_change_mode: "batch"` arms non-interactive
  // /livespec:propose-change (maintainer-directed fleet-wide autonomy
  // lever rollout, Increment 1 of the livespec-core spec-side-autonomy
  // design). The six keys below were added in the fleet-wide
  // autonomy-lever audit and rollout (epic livespec-jvdvx4, child
  // livespec-jvdvx4.15, 2026-08-16): these levers shipped in livespec
  // core but were never armed on this repo, which left
  // `revise_decision_mode` at its default `manual` — the root cause of
  // two sessions stalling on avoidable /livespec:revise human gates that
  // day. `doctor_dispositions` and `dispatcher.merge_on_review_cap` are
  // deliberately left unarmed by this same rollout (doctor_dispositions
  // needs its own per-check_id audit; merge_on_review_cap is a
  // documented, intentional non-autonomous default — see the
  // `dispatcher` block below).
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "revise_decision_mode": "delegated",
    "ratification_review": "auto-spawn",
    // ratification_reviewer_model: an ordered list. Opus is the primary
    // ratification reviewer and auto-spawn selects it; gpt-6-astra (Codex) is the
    // fallback, and a review by EITHER model ratifies. The models are
    // interchangeable like any other model selection here. "auto-spawn" above is
    // inert when this key is null.
    "ratification_reviewer_model": ["opus", "gpt-6-astra"],
    "spec_pr_merge": "auto-on-green"
  },
  // Optional — spec_governance: policy levers for livespec's spec-side
  // operations. The commented defaults below are derived from the shipped
  // spec-governance manifest; leaving this block commented arms nothing, so
  // every operation uses the same safe defaults it would use with no
  // spec_governance block at all.
  // To enable any key, add the block as a real key above (a comma after the
  // `harnesses` block) and keep only the entries this repo intentionally
  // overrides:
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus"; per-proposal override: decision_policy)
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn";
  //     // per-proposal override: ratification_review_policy)
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string; no enumerated allowed values)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1,
  //     // spec_pr_merge (enum; allowed: "manual", "auto-on-green")
  //     "spec_pr_merge": "manual"
  //   }
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  // Credential-injection wrapper (fleet default) prefixed to the beads CLIs so a bare invocation self-heals its tenant secret.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  "livespec-driver-claude": {
    "compat": {
      // semver range and pinned tag against livespec core. The pin is
      // "master" during bootstrap (always-HEAD dogfooding); doctor's
      // contract-version-compatibility invariant fires `warn` against a
      // "master" pin, which is expected pre-1.0.
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.44.0"
    }
  },
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": {
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.44.0"
    },
    // Per-repo beads tenant CONNECTION block, mirrored by .beads/config.yaml.
    // `prefix` == `tenant` == `database` == `server_user` == this repo's
    // name ("livespec-driver-claude") is the load-bearing tenant-identity
    // rule. TCP-only: NO `socket` key — the dolt unix socket dir is
    // 0750 dolt:dolt and inaccessible to the sandboxed caller, so the
    // connection goes over 127.0.0.1:3307. The tenant PASSWORD is
    // deliberately ABSENT (supplied via BEADS_DOLT_PASSWORD at call time).
    // `fake` is false so the committed config describes the REAL
    // connection; CI and tests set LIVESPEC_BEADS_FAKE=1 to force the
    // hermetic in-memory backend.
    "connection": {
      "tenant": "livespec-driver-claude",
      "prefix": "livespec-driver-claude",
      "database": "livespec-driver-claude",
      "server_user": "livespec-driver-claude",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the three
    // policy settings in livespec/SPECIFICATION/contracts.md §"The three policy
    // settings" are moved off their safe defaults so ready work is ADMITTED and
    // ACCEPTED without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The third lever, `merge_on_review_cap`, deliberately STAYS at its safe
    // `false` default and is NOT listed here: a review that cannot converge
    // within `review_fix_cap` rounds is precisely the case that must reach a
    // human, per the design record cited in that section. A design-human-gated
    // (spec-change-tier) item still cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      // CODEX-FIRST on every node (maintainer direction 2026-10-25: the factory runs OpenAI
      // models by default with Anthropic minimized; fleet-wide ruling by coordinator
      // gitops-fleet-capacity-monitoring). codex-acp is each node's primary and claude-acp
      // its fallback, used only when Codex hits its limit. Same block as
      // livespec-orchestrator-beads-fabro a03cbeb0. Only gpt-5.6-terra and gpt-5.6-luna,
      // the slugs proven reachable on the factory's ChatGPT account.
      "acp_nodes": {
        "dod_gate": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "implement": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "fix": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "review_fix": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "proof_capture": { "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "medium", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] },
        "proof_verify": { "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "medium", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] },
        "review": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "pr": { "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "low", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] },
        "disposition": { "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "low", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] }
      },
      "model_catalog": {
        "anthropic/claude-sonnet-5-5": {
          "display_name": "Claude Sonnet 5.5",
          "pricing": {
            "model": "claude-sonnet-5-5",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 10.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        }
      },
      // Committed mirror of the sandbox image's published capability set, read by
      // the Definition-of-Done gate and by the host-side judgements when
      // /etc/livespec/sandbox-capabilities is not reachable. MEASURED 2026-10-20 by
      // `docker run --rm --entrypoint cat ghcr.io/thewoolleyman/livespec-fabro-sandbox:python-agent-v1.118.7
      // /etc/livespec/sandbox-capabilities`, the image this repository's committed run
      // config resolves. Edit it by hand, in the same change that moves the image.
      "sandbox_capabilities": ["terminal", "tmux", "headless_browser", "herdr"],
      "auto_approve_ready": true,
      "acceptance_mode": "ai-only",
      "wip_cap": 10,
      // Factory-sandbox toolchain premise: the version-manager arm of
      // `dispatcher.prepare_toolchain`. The Dispatcher resolves this argv ONCE
      // and renders it into the workflow's `inputs.prepare_toolchain_mise`
      // step, which runs BEFORE `uv sync --all-groups` in the sandbox prepare
      // phase. Without it the fresh Fabro clone's `.mise.toml` is untrusted, so
      // `uv sync` aborts with "mise ERROR ... are not trusted. Trust them with
      // `mise trust`." and every dispatch dies at setup (evidence run
      // 01M2355GJ12C, workflow_error; work-item livespec-driver-claude-yki4pv).
      // `mise trust` clears that; `mise install` then resolves this repo's
      // `.mise.toml` binary pins (uv, just, lefthook, shellcheck). GITHUB_TOKEN
      // / GH_TOKEN / GITHUB_API_TOKEN are scrubbed for THIS command only so
      // mise's aqua backend makes its public release-metadata fetch anonymously
      // rather than draining the factory's shared App-installation rate-limit
      // bucket (the orchestrator's bd-ib-bic7hb root-cause, mirrored here).
      //
      // The `lefthook` arm is the hook-manager install (the second toolchain
      // premise), rendered into `inputs.prepare_toolchain_lefthook`, which runs
      // AFTER `uv sync`. `lefthook install` wires this repo's lefthook.yml git
      // hooks in the sandbox — including the commit-msg stage that runs
      // red-green-replay — so in-sandbox commits are gated the same way a
      // developer checkout's are. This repo pins lefthook as a mise binary (not
      // a uv dependency), exactly like the orchestrator; `uv run lefthook`
      // resolves the mise-installed binary from PATH, so the orchestrator's arm
      // mirrors verbatim. Leaving either arm absent resolves to the ratified
      // no-op (no setup crash) but is a silent degrade the Dispatcher warns
      // about, so both premises are declared explicitly per fleet convention.
      // (This repo declares no `dispatcher.conformance` block, so the separate
      // conformance commit-refuse hook install resolves to a no-op; the
      // `lefthook` arm is therefore the mechanism that wires the RGR gate
      // in-sandbox here.)
      "prepare_toolchain": {
        "mise": ["sh", "-c", "mise trust && env -u GITHUB_TOKEN -u GH_TOKEN -u GITHUB_API_TOKEN mise install --quiet"],
        "lefthook": ["uv", "run", "lefthook", "install"]
      },
      // Factory table, registry-backed per SPECIFICATION/non-functional-requirements.md
      // §"Factory routing": every entry committed here declares `"registry": true` and
      // carries NO `server` and NO `docker_host`, so no committed entry names a machine.
      // Which Fabro server answers to a factory name is bound ONLY in the fleet gitops
      // inventory's factory registry, which each dispatching host renders as
      // /etc/livespec/fabro-factories.json; a dispatch resolves each entry from that file
      // by name. Every instance below is named ONLY by its registry name — `petri` —
      // because that name is the whole of what this file may say about it.
      //
      // `petri` IS THE DEFAULT FACTORY, and has been since the R668 cutover (coordinator
      // rulings R668/R672, work-item bd-ib-iud52v, plan `petri-factory-on-gmktec`,
      // epic bd-ib-fyozyd), which onboarded `petri` with this repository's own bin and
      // secret-channel settings and pointed `default_factory` at it. So an unpinned
      // dispatch from this repository lands on `petri`. The earlier note here — that
      // moving to registry-backed entries changed no routing — described the state
      // BEFORE that cutover and no longer holds: the cutover is precisely a change to
      // which factory an unpinned dispatch resolves.
      //
      // `legacy`, the hp-xubuntu instance's registry name, was retired and removed from this table on 2026-10-24 (plan fabro-currency).
      // A recorded pin naming it now falls back to `default_factory` (the ratified
      // recorded-pin fallback); no open item needs a run read from hp.
      //
      // Coordinator rulings R318/R320 (2026-10-20, same plan) keep assertion 6 of that
      // plan whole: a factory is bound to a machine only in the inventory — which is
      // why neither an entry nor this comment names a host or a port.
      "factories": {
        // The current Fabro server, selected by default since the R668 cutover
        // (plan petri-factory-on-gmktec); resolved through the factory registry.
        "petri": {
          "registry": true,
          "bin": "/home/ubuntu/.local/state/fabro-currency/carrier-petri-v0.382-adeefec4c/fabro",
          "secret_channel": "native_secrets",
          // factory-python: the toolchain-named catalog id (livespec-dev-tooling
          // SPECIFICATION, "Factory sandbox environment naming"). Its provider, not
          // this id, says where the sandbox runs, so a provider move changes nothing here.
          "environment": "factory-python"
        }
      },
      "default_factory": "petri"
    }
  }
}
